{
  "manifest_version": 3,
  "name": "LearnMate - Gemini Text Assistant",
  "version": "3.0.0",
  "description": "Select text and use Gemini AI with LearnMate.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:8787/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "LearnMate",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}